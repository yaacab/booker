BOOKER_PUBLIC_URL=https://bukergo.ru
BOOKER_RUNTIME_ENV=production
BOOKER_DATABASE_URL=sqlite:////opt/booker/data/booker.db
BOOKER_CORS_ORIGINS=https://bukergo.ru,https://www.bukergo.ru
BOOKER_PAYMENT_PROVIDER=external
BOOKER_EMAIL_PROVIDER=smtp
BOOKER_EMAIL_SMTP_HOST={{SMTP_HOST}}
BOOKER_ALLOW_DEFAULT_WEBHOOK_SECRET=false
BOOKER_WEBHOOK_SECRET={{SET_UNIQUE_RANDOM_SECRET_MIN_32_CHARACTERS}}
BOOKER_REQUIRE_ADMIN_2FA_ENFORCED=true
BOOKER_TOTP_ENCRYPTION_KEYS={{FERNET_KEY_FROM_SECRET_STORAGE}}
BOOKER_IN_APP_PROVIDER=audit
NEXT_PUBLIC_API_URL=https://bukergo.ru/api
NEXT_PUBLIC_SITE_URL=https://bukergo.ru

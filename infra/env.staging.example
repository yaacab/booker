# Booker — isolated staging / local staging harness (NOT production)
# Copy to /tmp/booker-staging/.env or export before make staging-up.
# Loopback only. Never point BOOKER_DATABASE_URL at production.

BOOKER_RUNTIME_ENV=test
BOOKER_PUBLIC_URL=http://127.0.0.1:18080
BOOKER_CORS_ORIGINS=http://127.0.0.1:13000,http://127.0.0.1:18080
BOOKER_DATABASE_URL=postgresql+psycopg://booker_staging:booker_staging@127.0.0.1:15432/booker_staging
BOOKER_UPLOAD_DIR=/tmp/booker-staging-uploads
BOOKER_ALLOW_DEMO_SEED=1
BOOKER_PAYMENT_PROVIDER=stub
BOOKER_EMAIL_PROVIDER=disabled
BOOKER_IN_APP_PROVIDER=dev
BOOKER_SMS_PROVIDER=disabled
BOOKER_PUSH_PROVIDER=disabled
BOOKER_REQUIRE_ADMIN_2FA_ENFORCED=0
BOOKER_OBJECT_STORAGE_PROVIDER=local
BOOKER_MAX_UPLOAD_BYTES=5242880
BOOKER_HOLD_TTL_HOURS=24
BOOKER_COMPOSITION_V2=1
BOOKER_WORKSPACE_SWITCHER=1
NEXT_PUBLIC_API_URL=http://127.0.0.1:18080
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:13000

# Optional SQLite fallback when Docker/Postgres unavailable:
# BOOKER_DATABASE_URL=sqlite:////tmp/booker-staging/booker.db

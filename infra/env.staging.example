# Booker — staging harness example (NOT production).
# Copy to a path OUTSIDE Git, e.g.:
#   mkdir -p /tmp/booker-staging && chmod 700 /tmp/booker-staging
#   cp infra/env.staging.example /tmp/booker-staging/secrets.env
#   # replace every {{STAGING_PG_PASSWORD}} with: openssl rand -hex 24
#   export BOOKER_STAGING_ENV_FILE=/tmp/booker-staging/secrets.env
#
# Never commit secrets.env. Never use production credentials.
# Unreplaced {{…}} placeholders are refused by staging_preflight / staging-up.

BOOKER_RUNTIME_ENV=test
COMPOSE_PROJECT_NAME=booker-staging
BOOKER_PUBLIC_URL=http://127.0.0.1:18080
BOOKER_CORS_ORIGINS=http://127.0.0.1:13000,http://127.0.0.1:18080

# Compose Postgres credentials (must match URL below)
BOOKER_STAGING_PGUSER=booker_staging
BOOKER_STAGING_PGPASSWORD={{STAGING_PG_PASSWORD}}
BOOKER_STAGING_PGDATABASE=booker_staging

# Must be loopback :15432 and db/user booker_staging*
BOOKER_DATABASE_URL=postgresql+psycopg://booker_staging:{{STAGING_PG_PASSWORD}}@127.0.0.1:15432/booker_staging

BOOKER_UPLOAD_DIR=/tmp/booker-staging-uploads
BOOKER_ALLOW_DEMO_SEED=1
BOOKER_PAYMENT_PROVIDER=stub
BOOKER_EMAIL_PROVIDER=disabled
BOOKER_IN_APP_PROVIDER=dev
BOOKER_SMS_PROVIDER=disabled
BOOKER_PUSH_PROVIDER=disabled
BOOKER_REQUIRE_ADMIN_2FA_ENFORCED=0
BOOKER_OBJECT_STORAGE_PROVIDER=local
BOOKER_MAX_UPLOAD_BYTES=5242880
BOOKER_HOLD_TTL_HOURS=24
BOOKER_COMPOSITION_V2=1
BOOKER_WORKSPACE_SWITCHER=1
BOOKER_STAGING_API_PORT=18080
BOOKER_STAGING_WEB_PORT=13000
NEXT_PUBLIC_API_URL=http://127.0.0.1:18080
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:13000

# Optional SQLite LOCAL-only fallback (still must pass preflight):
# BOOKER_DATABASE_URL=sqlite:////tmp/booker-staging/booker.db

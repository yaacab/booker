# Букер — пример конфигурации (без секретов)
# Копировать: cp .env.example .env.local (dev) или systemd Environment= (prod)

BOOKER_DATABASE_URL=sqlite:///./booker.db
BOOKER_PUBLIC_URL=https://bukergo.ru
BOOKER_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
BOOKER_PAYMENT_PROVIDER=stub
BOOKER_PAYMENT_MERCHANT_ID=
BOOKER_PAYMENT_PUBLIC_KEY=
BOOKER_PAYMENT_SECRET_KEY=
BOOKER_WEBHOOK_SECRET=dev-webhook-secret-change-in-prod
BOOKER_LAWYER_APPROVAL_DATE=
BOOKER_PAYMENT_FLOW_APPROVAL=
BOOKER_SUPPORT_EMAIL=
BOOKER_REQUIRE_ADMIN_2FA_ENFORCED=0
BOOKER_HOLD_TTL_HOURS=24
BOOKER_COMPOSITION_V2=1
BOOKER_WORKSPACE_SWITCHER=1
BOOKER_UPLOAD_DIR=./data/uploads
BOOKER_MAX_UPLOAD_BYTES=5242880
BOOKER_OBJECT_STORAGE_PROVIDER=local
BOOKER_EMAIL_PROVIDER=disabled
BOOKER_EMAIL_API_KEY=
BOOKER_SMS_PROVIDER=disabled
BOOKER_SMS_API_KEY=
BOOKER_PUSH_PROVIDER=disabled
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
